# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE
.idea/
.vscode/

# Environment / secrets
.env

# Corpus: raw sources are not committed (large, licensed). Processed output is derived.
corpus/raw/*
!corpus/raw/.gitkeep
corpus/processed/*
!corpus/processed/.gitkeep

# Topic corpora (article-06 model matrix): same policy - third-party content
# (WHO fact sheets, GNU GPL FAQ, vendor guides) is fetched and converted
# locally by scripts/fetch_topic_corpus.py + scripts/convert_topic_corpus.py,
# never committed. Only our own golden sets and code are.
corpus/topics/

# Personal logs (per checklists.md these may be kept local)
retro-inbox.md
session-log.md

# Runtime artifacts: query log + last eval results (regenerated locally)
data/

# Private planning notes (not published)
docs/ROADMAP.md

# Writeups are published separately as articles
docs/writeups/
